# Copy the names into Vercel → Settings → Environment Variables (Production and Preview).
# Never commit real values. Local development needs none of these.

# Storage (added automatically by Vercel → Storage → Upstash for Redis)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Signs login cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Your custom domain, no trailing slash. Used for canonical links, sitemap and reset links.
SITE_URL=https://vybez.example

# Password-reset email through Resend. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Vybez <hello@vybez.example>

# Shown on Privacy, Terms, Help and security.txt. Use a domain address, not a personal inbox.
CONTACT_EMAIL=hello@vybez.example
# Who runs Vybez: your full name or registered business name.
LEGAL_NAME=
# Optional: overrides the "last updated" date on Privacy and Terms.
LEGAL_UPDATED=

# 1 opens Vybez DJ. Leave empty while DJ is coming soon.
DJ_OPEN=

# Photos (added automatically by Vercel → Storage → Blob, private access). Without it photos go into Redis.
BLOB_READ_WRITE_TOKEN=

# Error tracking: the DSN from Sentry → Project Settings → Client Keys. Without it errors only go to Vercel logs.
SENTRY_DSN=
